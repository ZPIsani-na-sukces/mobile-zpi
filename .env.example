# Copy to .env and run with: flutter run --dart-define-from-file=.env
# DEV | PROD (when not set: DEV in debug builds, PROD in profile/release)
APP_ENV=DEV
# true | false (when not set: true in DEV, false in PROD)
USE_MOCKS=true
# Base URL of the backend API, with the version prefix and no trailing slash
API_BASE_URL=http://localhost:8080/api/v1
